import pandas as pd

# ==========================================================
# Load CSV File
# ==========================================================
file_path = r"your_file.csv"      # Change to your CSV file

df = pd.read_csv(file_path)

# ==========================================================
# Function to calculate sampling rate
# ==========================================================
def calculate_sampling_rate(time_series, column_name):
    # Remove empty values and convert to numeric
    time = pd.to_numeric(time_series, errors='coerce').dropna()

    if len(time) < 2:
        print(f"\n{column_name}")
        print("Not enough samples.")
        return

    first_time = time.iloc[0]
    last_time = time.iloc[-1]
    num_samples = len(time)
    num_intervals = num_samples - 1
    duration = last_time - first_time

    avg_dt = duration / num_intervals
    sampling_rate = 1 / avg_dt

    print("=" * 60)
    print(f"{column_name}")
    print("=" * 60)
    print(f"First Timestamp      : {first_time:.6f} s")
    print(f"Last Timestamp       : {last_time:.6f} s")
    print(f"Duration             : {duration:.6f} s")
    print(f"Number of Samples    : {num_samples}")
    print(f"Number of Intervals  : {num_intervals}")
    print(f"Avg Sampling Time    : {avg_dt:.6f} s ({avg_dt*1000:.2f} ms)")
    print(f"Sampling Rate        : {sampling_rate:.3f} Hz")

# ==========================================================
# Column A
# ==========================================================
calculate_sampling_rate(df.iloc[:, 0], "Column A")

# ==========================================================
# Column J
# ==========================================================
calculate_sampling_rate(df.iloc[:, 9], "Column J")
