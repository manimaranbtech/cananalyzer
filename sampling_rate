import pandas as pd
import numpy as np

# ==========================================================
# Load CSV File
# ==========================================================
file_path = r"your_file.csv"

df = pd.read_csv(file_path)

# ==========================================================
# Function to check sampling consistency
# ==========================================================
def check_sampling(time_series, column_name, tolerance_ms=1):
    """
    tolerance_ms = allowable variation in milliseconds
    """

    # Remove NaN and convert to numeric
    time = pd.to_numeric(time_series, errors="coerce").dropna().reset_index(drop=True)

    if len(time) < 2:
        print(f"\n{column_name}: Not enough samples.")
        return

    # Consecutive time differences
    dt = np.diff(time)

    mean_dt = np.mean(dt)
    median_dt = np.median(dt)
    min_dt = np.min(dt)
    max_dt = np.max(dt)
    std_dt = np.std(dt)

    sampling_rate = 1 / mean_dt

    print("\n" + "="*65)
    print(column_name)
    print("="*65)

    print(f"Samples               : {len(time)}")
    print(f"Average dt            : {mean_dt:.6f} s ({mean_dt*1000:.3f} ms)")
    print(f"Median dt             : {median_dt:.6f} s")
    print(f"Minimum dt            : {min_dt:.6f} s")
    print(f"Maximum dt            : {max_dt:.6f} s")
    print(f"Std deviation         : {std_dt*1000:.3f} ms")
    print(f"Average Sampling Rate : {sampling_rate:.3f} Hz")

    # Check constant sampling
    tolerance = tolerance_ms / 1000

    bad = np.sum(np.abs(dt - mean_dt) > tolerance)

    print(f"\nTolerance             : ±{tolerance_ms} ms")
    print(f"Intervals outside tol : {bad} / {len(dt)}")

    if bad == 0:
        print("✔ Sampling is effectively CONSTANT.")
    else:
        print("✘ Sampling is NOT constant.")

    print(f"Unique dt values      : {len(np.unique(np.round(dt,6)))}")

    # Largest deviation
    idx = np.argmax(np.abs(dt - mean_dt))

    print("\nLargest deviation")
    print("-----------------")
    print(f"Index                : {idx}")
    print(f"Actual dt            : {dt[idx]:.6f} s")
    print(f"Deviation            : {(dt[idx]-mean_dt)*1000:.3f} ms")


# ==========================================================
# Column A
# ==========================================================
check_sampling(df.iloc[:,0], "Column A")

# ==========================================================
# Column J
# ==========================================================
check_sampling(df.iloc[:,9], "Column J")




